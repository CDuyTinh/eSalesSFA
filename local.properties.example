# Copy file này thành `local.properties` rồi điền giá trị thật.
# `local.properties` đã nằm trong .gitignore — KHÔNG BAO GIỜ commit key thật.

sdk.dir=C\:\\Users\\<user>\\AppData\\Local\\Android\\Sdk

# Supabase — Settings > API Keys (tab "API Keys", KHÔNG dùng tab "Legacy API Keys")
# URL: KHÔNG kèm /rest/v1/ ở cuối — SDK tự thêm.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Google Maps — lấy ở Google Cloud Console, nhớ giới hạn theo SHA-1 + package name
MAPS_API_KEY=AIzaSy...
