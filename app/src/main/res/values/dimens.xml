<?xml version="1.0" encoding="utf-8"?>
<!-- Thang khoảng cách và cỡ chữ lấy theo bản eSales gốc: chữ nhỏ, mật độ dày,
     vì nhân viên cần thấy nhiều dòng trên một màn hình khi đứng tại cửa hàng. -->
<resources>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>

    <dimen name="card_radius">8dp</dimen>
    <dimen name="card_elevation">1dp</dimen>

    <dimen name="text_tiny">11sp</dimen>
    <dimen name="text_small">13sp</dimen>
    <dimen name="text_body">15sp</dimen>
    <dimen name="text_title">17sp</dimen>
    <dimen name="text_number">22sp</dimen>

    <dimen name="thumb_size">56dp</dimen>

    <!-- ── Splash &amp; Login ─────────────────────────────────────────────────
         Số đo lấy đúng theo bản eSales gốc để bố cục cân giống bản gốc. -->
    <dimen name="login_panel_height">340dp</dimen>
    <dimen name="login_panel_radius">16dp</dimen>
    <!-- Bản gốc đặt ImageView 150dp nhưng ảnh trong đó gói cả chữ "eSales SFA",
         đĩa tròn thật chỉ chiếm khoảng 45% — tức ~68dp. Ở đây chữ là TextView
         riêng nên đĩa phải khai đúng cỡ của nó, không lấy 150dp. -->
    <dimen name="logo_size">100dp</dimen>
    <dimen name="login_logo_margin_top">32dp</dimen>
    <dimen name="splash_footer_margin_bottom">24dp</dimen>
    <dimen name="login_input_radius">10dp</dimen>
    <dimen name="text_brand">26sp</dimen>
    <dimen name="text_brand_splash">22sp</dimen>
</resources>
