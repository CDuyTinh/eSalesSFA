<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!--
      popUpTo + popUpToInclusive ở mọi action: sau khi đi tiếp thì màn trước bị gỡ
      khỏi back stack. Nếu không, bấm Back từ Home sẽ quay lại màn Sync và chạy
      đồng bộ lại, hoặc quay về màn Login dù đã đăng nhập.
    -->

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.tinhcd.esalessfa.feature.splash.SplashFragment"
        android:label="Splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_sync"
            app:destination="@id/syncFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.tinhcd.esalessfa.feature.auth.LoginFragment"
        android:label="Đăng nhập">
        <action
            android:id="@+id/action_login_to_sync"
            app:destination="@id/syncFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/syncFragment"
        android:name="com.tinhcd.esalessfa.feature.sync.SyncFragment"
        android:label="Đồng bộ dữ liệu">
        <!-- FIRST_RUN: vào từ Splash/Login, chỉ tải xuống rồi đi tiếp vào Home.
             MANUAL: vào từ Home, gửi lên rồi tải xuống, xong thì quay lại. -->
        <argument
            android:name="mode"
            app:argType="string"
            android:defaultValue="FIRST_RUN" />
        <action
            android:id="@+id/action_sync_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/syncFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.tinhcd.esalessfa.feature.home.HomeFragment"
        android:label="Trang chủ">
        <!-- Không popUpTo: từ danh sách bấm Back phải quay về Home. -->
        <action
            android:id="@+id/action_home_to_customerList"
            app:destination="@id/customerListFragment" />
        <action
            android:id="@+id/action_home_to_sync"
            app:destination="@id/syncFragment" />
    </fragment>

    <fragment
        android:id="@+id/customerListFragment"
        android:name="com.tinhcd.esalessfa.feature.customer.CustomerListFragment"
        android:label="Khách hàng">
        <argument
            android:name="mode"
            app:argType="string"
            android:defaultValue="ROUTE_TODAY" />
    </fragment>

    <fragment
        android:id="@+id/customerMapFragment"
        android:name="com.tinhcd.esalessfa.feature.customer.CustomerMapFragment"
        android:label="Bản đồ tuyến" />

    <fragment
        android:id="@+id/customerDetailFragment"
        android:name="com.tinhcd.esalessfa.feature.customer.CustomerDetailFragment"
        android:label="Chi tiết khách hàng">
        <argument
            android:name="customerId"
            app:argType="string" />
        <action
            android:id="@+id/action_customerDetail_to_orderEdit"
            app:destination="@id/orderEditFragment" />
        <action
            android:id="@+id/action_customerDetail_to_checkIn"
            app:destination="@id/checkInFragment" />
        <action
            android:id="@+id/action_customerDetail_to_stockCount"
            app:destination="@id/stockCountFragment" />
        <action
            android:id="@+id/action_customerDetail_to_survey"
            app:destination="@id/surveyFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderEditFragment"
        android:name="com.tinhcd.esalessfa.feature.order.OrderEditFragment"
        android:label="Đặt hàng">
        <argument
            android:name="customerId"
            app:argType="string" />
        <action
            android:id="@+id/action_orderEdit_to_productPicker"
            app:destination="@id/productPickerFragment" />
    </fragment>

    <fragment
        android:id="@+id/productPickerFragment"
        android:name="com.tinhcd.esalessfa.feature.order.ProductPickerFragment"
        android:label="Chọn sản phẩm" />

    <fragment
        android:id="@+id/stockCountFragment"
        android:name="com.tinhcd.esalessfa.feature.inventory.StockCountFragment"
        android:label="Kiểm kê tồn kho">
        <argument
            android:name="customerId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.tinhcd.esalessfa.feature.report.DashboardFragment"
        android:label="Báo cáo">
        <action
            android:id="@+id/action_dashboard_to_orderReport"
            app:destination="@id/orderReportFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderReportFragment"
        android:name="com.tinhcd.esalessfa.feature.report.OrderReportFragment"
        android:label="Báo cáo đơn hàng" />

    <!-- Mở từ tab "Đơn hàng" của màn báo cáo. Điều hướng theo ID ĐÍCH chứ không
         theo action: màn báo cáo còn chạy trong tab của Home, lúc đó đích hiện
         tại là homeFragment nên action khai ở orderReportFragment không giải
         được. -->
    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="com.tinhcd.esalessfa.feature.report.OrderDetailFragment"
        android:label="Chi tiết đơn hàng">
        <argument
            android:name="orderId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/surveyFormFragment"
        android:name="com.tinhcd.esalessfa.feature.survey.SurveyFormFragment"
        android:label="Khảo sát">
        <argument android:name="customerId" app:argType="string" />
        <argument android:name="surveyTypeId" app:argType="string" />
        <action
            android:id="@+id/action_surveyForm_to_camera"
            app:destination="@id/cameraFragment" />
    </fragment>

    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.tinhcd.esalessfa.feature.survey.CameraFragment"
        android:label="Chụp ảnh" />

    <fragment
        android:id="@+id/checkInFragment"
        android:name="com.tinhcd.esalessfa.feature.visit.CheckInFragment"
        android:label="Check-in">
        <argument
            android:name="customerId"
            app:argType="string" />
    </fragment>
</navigation>
