<?xml version="1.0" encoding="utf-8"?>
<!--
  Khung chứa tab, theo home.xml của bản eSales gốc: một FrameLayout đổi nội dung
  theo tab và một BottomNavigationView dán đáy.

  Không dùng NavHostFragment lồng bên trong cho các tab. Lồng NavHost sẽ tạo ra
  NavController thứ hai, và mọi màn đi sâu từ tab (chi tiết khách hàng, đặt hàng,
  kiểm kê) sẽ mở BÊN TRONG vùng tab, nằm trên thanh tab — trong khi chúng phải
  chiếm cả màn hình. Đổi fragment bằng FragmentManager thì các màn đó vẫn đi qua
  NavController duy nhất ở MainActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <FrameLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- itemActiveIndicatorStyle=@null: Material 3 vẽ một viên thuốc bo tròn sau
         icon đang chọn, bản gốc không có. Chỉ đổi màu icon và chữ. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextColor="@color/bottom_nav_item"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/home_bottom_nav" />
</LinearLayout>
