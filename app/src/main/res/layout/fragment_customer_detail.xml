<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn chi tiết khách hàng theo CustomerInforActivity của bản eSales gốc: ảnh cửa
  hàng co giãn ở trên, tên và mã nằm trên nền chuyển sắc, toolbar ghim lại khi
  cuộn, và hàng tab ở đáy phần đầu.

  Tab "Công việc" chỉ có mặt khi đang check-in TẠI cửa hàng này nên số tab thay
  đổi lúc chạy; vì vậy nội dung tab do code nạp vào container, không khai cứng.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brandRed"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="@color/brandRed"
            app:titleEnabled="false"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <!-- Bo hai góc dưới của khối ảnh, giống RoundedView của bản gốc.
                 Việc bo do code làm (View.roundBottomCorners): cắt bằng outline
                 thì ảnh và dải tối bên trong cùng bị cắt theo, còn nền bo sẵn
                 của MaterialCardView chỉ bo phần nền, để lộ hai góc tối. -->
            <FrameLayout
                android:id="@+id/photoHeader"
                android:layout_width="match_parent"
                android:layout_height="@dimen/customer_photo_height"
                android:background="@color/brandRedLight"
                app:layout_collapseMode="parallax">

                <!-- Chữ cái đầu tên làm nền: master data nhiều khách chưa có ảnh,
                     ô trống trơn nhìn như đang tải lỗi. -->
                <TextView
                    android:id="@+id/photoInitial"
                    style="@style/Sfa.Text.Brand"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    tools:text="C" />

                <ImageView
                    android:id="@+id/photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:importantForAccessibility="no"
                    tools:visibility="visible" />

                <!-- Nền tối dần từ dưới lên để chữ trắng đọc được trên mọi ảnh. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_photo_scrim"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingTop="@dimen/space_xl"
                    android:paddingBottom="@dimen/space_md">

                    <TextView
                        android:id="@+id/name"
                        style="@style/Sfa.Text.Title"
                        android:layout_width="match_parent"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="@color/white"
                        tools:text="Cửa hàng Bình Minh 4" />

                    <TextView
                        android:id="@+id/code"
                        style="@style/Sfa.Text.Small"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/white"
                        tools:text="KH0004" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Sfa.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/white"
                app:title="@string/customer_tab_info"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!--
          Ba tab là ba chip rời nhau, theo Ext.TabLayout.Focus.Primary của bản
          gốc. Không dùng TabLayout: hàng tab này nằm trên nền đỏ, mỗi chip cần
          nền riêng và một khoảng hở giữa các chip — TabLayout không có thuộc
          tính nào cho khoảng hở, còn nền chip thì nó tự vẽ lệch khỏi chữ. Ba nút
          checkable xếp theo weight cho ra đúng hình mong muốn và dễ đọc hơn.

          Chip "Công việc" bị ẩn khi không được thao tác, nên hai chip đầu mang
          lề phải: bỏ chip đầu đi thì hàng còn lại vẫn cách nhau đúng như cũ.
        -->
        <LinearLayout
            android:id="@+id/tabRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabWork"
                style="@style/Sfa.TabChip"
                android:layout_marginEnd="@dimen/space_sm"
                android:text="@string/customer_tab_work" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabInfo"
                style="@style/Sfa.TabChip"
                android:layout_marginEnd="@dimen/space_sm"
                android:text="@string/customer_tab_info" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabProgram"
                style="@style/Sfa.TabChip"
                android:text="@string/customer_tab_program" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
