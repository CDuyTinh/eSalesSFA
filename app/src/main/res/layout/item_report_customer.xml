<?xml version="1.0" encoding="utf-8"?>
<!--
  Một dòng của tab "Khách hàng", theo report_customer_item của bản gốc: bên trái
  là tên rồi mã kèm số mặt hàng đã mua, bên phải là tiền rồi số đơn.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Sfa.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                style="@style/Sfa.Text.Small"
                android:layout_width="match_parent"
                android:textColor="@color/textDark"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Cửa hàng Phương Nam 5" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/code"
                    style="@style/Sfa.Text.Tiny"
                    tools:text="KH0005" />

                <TextView
                    android:id="@+id/skuCount"
                    style="@style/Sfa.Text.Tiny"
                    android:layout_marginStart="@dimen/space_sm"
                    android:textColor="@color/stateGreen"
                    tools:text="8 mặt hàng" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/amount"
                style="@style/Sfa.Text.Body"
                android:textStyle="bold"
                android:textColor="@color/brandRed"
                tools:text="12.480.000" />

            <TextView
                android:id="@+id/orderCount"
                style="@style/Sfa.Text.Tiny"
                android:layout_marginTop="2dp"
                tools:text="5 đơn" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
