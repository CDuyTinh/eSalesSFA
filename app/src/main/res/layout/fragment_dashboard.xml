<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Sfa.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="@string/dashboard_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Doanh số hôm nay: con số lớn nhất màn hình vì đây là chỉ số
                 nhân viên nhìn nhiều lần trong ngày. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Sfa.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        style="@style/Sfa.Text.Tiny"
                        android:text="@string/dashboard_today" />

                    <TextView
                        android:id="@+id/todayRevenue"
                        style="@style/Sfa.Text.Number"
                        android:layout_marginTop="2dp"
                        android:textSize="28sp"
                        tools:text="12.480.000" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/todayOrders"
                                style="@style/Sfa.Text.Title"
                                tools:text="4" />
                            <TextView
                                style="@style/Sfa.Text.Tiny"
                                android:text="@string/dashboard_orders" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/lineGray" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/todayVisits"
                                style="@style/Sfa.Text.Title"
                                tools:text="3" />
                            <TextView
                                style="@style/Sfa.Text.Tiny"
                                android:text="@string/dashboard_visits" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Biểu đồ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Sfa.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        style="@style/Sfa.Text.Body"
                        android:textStyle="bold"
                        android:text="@string/dashboard_chart_title" />

                    <com.tinhcd.esalessfa.core.ui.BarChartView
                        android:id="@+id/chart"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="@dimen/space_md" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KPI tháng -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Sfa.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        style="@style/Sfa.Text.Body"
                        android:textStyle="bold"
                        android:text="@string/dashboard_month" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/Sfa.Text.Small"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/dashboard_month_revenue" />
                        <TextView
                            android:id="@+id/monthRevenue"
                            style="@style/Sfa.Text.Body"
                            android:textStyle="bold"
                            tools:text="128.400.000" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/Sfa.Text.Small"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/dashboard_month_orders" />
                        <TextView
                            android:id="@+id/monthOrders"
                            style="@style/Sfa.Text.Body"
                            tools:text="42" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/Sfa.Text.Small"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/dashboard_avg_order" />
                        <TextView
                            android:id="@+id/avgOrderValue"
                            style="@style/Sfa.Text.Body"
                            tools:text="3.057.000" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Xếp hạng -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Sfa.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        style="@style/Sfa.Text.Body"
                        android:textStyle="bold"
                        android:text="@string/dashboard_top_products" />

                    <TextView
                        android:id="@+id/topProducts"
                        style="@style/Sfa.Text.Small"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/space_sm"
                        android:lineSpacingExtra="5dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_md"
                        android:background="@color/lineGray" />

                    <TextView
                        style="@style/Sfa.Text.Body"
                        android:textStyle="bold"
                        android:text="@string/dashboard_top_customers" />

                    <TextView
                        android:id="@+id/topCustomers"
                        style="@style/Sfa.Text.Small"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/space_sm"
                        android:lineSpacingExtra="5dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportButton"
                style="@style/Sfa.Button"
                android:layout_marginHorizontal="@dimen/space_md"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/dashboard_open_report" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
