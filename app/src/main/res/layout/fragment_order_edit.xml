<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/img">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Sfa.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/action_take_order" />

    <TextView
        android:id="@+id/promotionSummary"
        style="@style/Sfa.Text.Tiny"
        android:layout_width="match_parent"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_sm"
        android:background="@color/stateGreenFaint"
        android:textColor="@color/stateGreen"
        android:visibility="gone"
        tools:text="Áp dụng: KM01, KM06" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lineList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/emptyText"
            style="@style/Sfa.Text.Small"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/space_xl"
            android:text="@string/order_empty"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Thanh tổng tiền cố định đáy màn: nhân viên đọc lại con số này sau mỗi
         lần đổi số lượng, không nên phải cuộn xuống mới thấy. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="8dp"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                style="@style/Sfa.Text.Small"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/order_subtotal" />
            <TextView
                android:id="@+id/subTotal"
                style="@style/Sfa.Text.Small"
                android:textColor="@color/textDark"
                tools:text="10.000.000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs">
            <TextView
                style="@style/Sfa.Text.Small"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/order_discount" />
            <TextView
                android:id="@+id/discountTotal"
                style="@style/Sfa.Text.Small"
                android:textColor="@color/stateGreen"
                tools:text="-500.000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs">
            <TextView
                style="@style/Sfa.Text.Small"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/order_vat" />
            <TextView
                android:id="@+id/vatTotal"
                style="@style/Sfa.Text.Small"
                android:textColor="@color/textDark"
                tools:text="760.000" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/space_sm"
            android:background="@color/lineGray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                style="@style/Sfa.Text.Body"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textStyle="bold"
                android:text="@string/order_total" />
            <TextView
                android:id="@+id/grandTotal"
                style="@style/Sfa.Text.Number"
                tools:text="10.260.000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addProductButton"
                style="@style/Sfa.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/order_add_product" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmButton"
                style="@style/Sfa.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/order_confirm" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
