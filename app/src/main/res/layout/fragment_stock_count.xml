<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/img">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Sfa.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/action_stock_count" />

    <!-- Thẻ tiến độ đếm: trước đây chỉ là một dòng chữ nhỏ nhét trong thẻ, vừa
         khó đọc vừa không cho biết còn bao nhiêu mặt hàng nữa. -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Sfa.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/progressText"
                    style="@style/Sfa.Text.Small"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textColor="@color/textDark"
                    tools:text="Đã đếm 4/28 mặt hàng" />

                <TextView
                    android:id="@+id/progressPercent"
                    style="@style/Sfa.Text.Body"
                    android:textStyle="bold"
                    android:textColor="@color/brandRed"
                    tools:text="14%" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:indicatorColor="@color/brandRed"
                app:trackColor="@color/lineSoft"
                app:trackCornerRadius="3dp"
                app:trackThickness="6dp"
                tools:progress="14" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lineList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/stock_empty"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="8dp"
        android:padding="@dimen/space_lg">

        <TextView
            android:id="@+id/suggestSummary"
            style="@style/Sfa.Text.Small"
            android:layout_width="match_parent"
            tools:text="Gợi ý đặt tổng cộng 142 đơn vị" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/Sfa.Button"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/stock_save" />
    </LinearLayout>
</LinearLayout>
