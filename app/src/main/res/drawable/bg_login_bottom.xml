<?xml version="1.0" encoding="utf-8"?>
<!--
  Tấm đỏ ở nửa dưới màn Login, thay cho ảnh `img_login_bottom` của bản gốc.

  Chỉ bo hai góc trên vì tấm này dán sát đáy màn hình — bo cả bốn góc sẽ hở ra
  hai khe trắng ở dưới.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners
        android:topLeftRadius="@dimen/login_panel_radius"
        android:topRightRadius="@dimen/login_panel_radius" />

    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="@color/brandRedGradientEnd"
        android:endColor="@color/brandRedGradientStart" />
</shape>
