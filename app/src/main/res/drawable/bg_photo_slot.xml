<?xml version="1.0" encoding="utf-8"?>
<!-- Ô chờ chụp ảnh: nền xám rất nhạt, viền đứt cho thấy đây là chỗ trống cần
     điền chứ không phải một khối nội dung. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surfaceGray" />
    <stroke
        android:width="1dp"
        android:color="@color/lineSoft"
        android:dashWidth="6dp"
        android:dashGap="4dp" />
    <corners android:radius="@dimen/card_radius" />
</shape>
