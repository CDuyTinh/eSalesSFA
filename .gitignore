*.iml
.gradle
.kotlin/
.DS_Store
.externalNativeBuild
.cxx
/captures

# Build output — multi-module nên phải match ở mọi cấp, không chỉ /build
build/

# ⚠️ SECRETS — chứa SUPABASE_URL, SUPABASE_ANON_KEY, MAPS_API_KEY
local.properties
*.jks
*.keystore
secrets.properties

# IDE — toàn bộ .idea/ là cấu hình máy cá nhân (đường dẫn SDK, JDK, workspace),
# commit vào chỉ gây conflict vô nghĩa giữa các máy.
.idea/

# Room schema: KHÔNG ignore — schema JSON phải được commit để review migration trong PR
!**/schemas/*.json

# Supabase CLI — state cục bộ của máy, không phải cấu hình project
supabase/.temp/
supabase/.branches/
